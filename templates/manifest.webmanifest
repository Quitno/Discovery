{
  "name": {{ brand|tojson }},
  "short_name": {{ brand[:18]|tojson }},
  "description": "Discover connected services, places and businesses from one starting point.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": {{ theme.bg|tojson }},
  "theme_color": {{ theme.primary|tojson }},
